# ==============================================================================
# 🚀 CITYPULSE ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER (BACKEND ENVIRONMENT VARIABLES)
# Set these in: Render Dashboard -> Your Web Service -> Environment
# ------------------------------------------------------------------------------

# Port the backend binds to (Render sets this dynamically, defaults to 3000 locally)
PORT=3000

# Environment Mode
NODE_ENV=development

# JWT Authentication Secret Key (replace with a long secure random string in production)
JWT_SECRET=replace-with-a-long-random-secret

# Allowed Frontend URL for CORS
# Put your Netlify site URL (e.g., https://your-app-name.netlify.app) or * to allow all origins
CLIENT_URL=http://localhost:3000

# Google Gemini API Key for AI-powered issue classification & auto-routing
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Supabase direct PostgreSQL connection string for persistent data in production.
DATABASE_URL=


# ------------------------------------------------------------------------------
# 2. NETLIFY (FRONTEND ENVIRONMENT VARIABLES)
# Set these in: Netlify Dashboard -> Site configuration -> Environment variables
# ------------------------------------------------------------------------------

# VITE_API_URL is intentionally blank for the recommended all-in-one Render setup.
VITE_API_URL=

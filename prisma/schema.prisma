// Citypulse Prisma Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  AUTHORITY
  ADMIN
}

enum IssueStatus {
  reported
  in_progress
  resolved
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CITIZEN)
  age          Int?
  area         String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reports      Report[]
}

model Report {
  id                 String          @id @default(uuid())
  title              String
  description        String
  category           String
  severity           String
  status             IssueStatus     @default(reported)
  latitude           Float
  longitude          Float
  address            String
  imageUrl           String?
  upvotes            Int             @default(0)
  priorityScore      Int             @default(50)
  aiSummary          String?
  aiSeverity         String?
  aiConfidence       Float?
  aiReason           String?
  recommendedAction  String?
  isAnonymous        Boolean         @default(false)
  createdBy          String          @default("Citizen")
  user               User?           @relation(fields: [userId], references: [id])
  userId             String?
  history            ReportHistory[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model ReportHistory {
  id        String      @id @default(uuid())
  reportId  String
  report    Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  oldStatus IssueStatus?
  newStatus IssueStatus
  comment   String
  updatedBy String      @default("System")
  createdAt DateTime    @default(now())
}
